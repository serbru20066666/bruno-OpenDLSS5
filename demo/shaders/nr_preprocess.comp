#version 460
// DLSS-NR input features from the scene color, the reprojected neural history and the controls
// f32 [fullHeight][fullWidth][16].
#extension GL_GOOGLE_include_directive : require
#include "nr_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D sceneColor;      // rgba16f, linear HDR (top-down rows)
layout(set = 0, binding = 1) uniform sampler2D historyPrev;     // rgba16f neural half surface (linear sampler)
layout(set = 0, binding = 2) uniform sampler2D motionTex;       // rg16f: current -> previous, uv units
layout(std430, set = 0, binding = 3) writeonly buffer Features { vec4 features[]; };   // 4 x vec4 per pixel (coalesced 16 B stores)
layout(std140, set = 0, binding = 4) uniform Params { NrParams params; };

float hashUniform(uint value) {
  uint mixed = value;
  mixed = (mixed >> ((mixed >> 28u) + 4u)) ^ mixed;
  mixed *= 0x108ef2d9u;
  uint integer = ((mixed >> 30u) ^ (mixed >> 8u)) + 1u;
  return float(integer) * uintBitsToFloat(0x33800000u);
}

vec3 gaussian3(uint x, uint y, uint seed) {
  uint base = (x * 0x8da6b343u) ^ (y * 0xd8163841u) ^ (seed * 0x9e3779b9u) ^ 0x243f6a88u;
  base = (base >> ((base >> 28u) + 4u)) ^ base;
  base *= 0x108ef2d9u;
  base = (base >> 22u) ^ base;
  float u0 = hashUniform(base * 0x2c9277b5u + 0xac564b05u);
  float u1 = hashUniform(base * 0xfa6dc5f9u + 0x4712a88eu);
  float u2 = hashUniform(base * 0xcaa5b80du + 0x21dd796bu);
  float u3 = hashUniform(base * 0x83232c31u + 0x3463e0acu);
  float radius0 = sqrt(log2(u0) * uintBitsToFloat(0x3f317218u) * -2.0);
  float radius1 = sqrt(log2(u2) * uintBitsToFloat(0x3f317218u) * -2.0);
  float tau = uintBitsToFloat(0x40c90fdbu);
  return vec3(roundF16(radius0 * cos(u1 * tau)), roundF16(radius0 * sin(u1 * tau)), roundF16(radius1 * cos(u3 * tau)));
}

void main() {
  uvec2 id = gl_GlobalInvocationID.xy;
  if (id.x >= params.fullWidth || id.y >= params.fullHeight) return;
  int reflectedX = id.x < params.validWidth ? int(id.x) : 2 * int(params.validWidth) - int(id.x) - 2;
  int reflectedY = id.y < params.validHeight ? int(id.y) : 2 * int(params.validHeight) - int(id.y) - 2;
  uint sourceX = uint(clamp(reflectedX, 0, int(params.sourceWidth) - 1));
  uint sourceY = uint(clamp(reflectedY, 0, int(params.sourceHeight) - 1));
  vec4 raw = texelFetch(sceneColor, ivec2(sourceX, sourceY), 0);
  vec3 scene = vec3(finiteNonnegative(raw.r), finiteNonnegative(raw.g), finiteNonnegative(raw.b));
  vec3 proxy = vec3(proxyComponent(scene.r, params.paperWhite), proxyComponent(scene.g, params.paperWhite),
                    proxyComponent(scene.b, params.paperWhite));
  vec3 centered = vec3(roundF16(roundF16(roundF16(proxy.r) - 0.5) * 0.125),
                       roundF16(roundF16(roundF16(proxy.g) - 0.5) * 0.125),
                       roundF16(roundF16(roundF16(proxy.b) - 0.5) * 0.125));
  vec3 noise = gaussian3(id.x, id.y, params.seed);
  uint base = (id.y * params.fullWidth + id.x) * 4u;
  features[base + 0u] = vec4(noise, 1.0);
  // lanes 7-9: the reprojected previous output, centred like the proxy; without a history (a reset, or a surface the
  // previous frame did not show) the current proxy stands in, as on the first frame
  vec3 history = centered;
  if (params.historyValid != 0u && hasHistory(motionTex, vec2(sourceX, sourceY), vec2(params.validWidth, params.validHeight))) {
    vec3 h = historySample(historyPrev, motionTex, vec2(sourceX, sourceY), vec2(params.validWidth, params.validHeight));
    history = vec3(roundF16(roundF16(roundF16(h.r) - 0.5) * 0.125), roundF16(roundF16(roundF16(h.g) - 0.5) * 0.125),
                   roundF16(roundF16(roundF16(h.b) - 0.5) * 0.125));
  }
  features[base + 1u] = vec4(centered, history.r);
  features[base + 2u] = vec4(history.g, history.b, params.style / 128.0, roundF16(params.localTone));
  features[base + 3u] = vec4(roundF16(params.autoMask > 0.0 ? 1.0 : params.localStructure),
                             roundF16(params.autoMask > 0.0 ? (params.skinStructure < 0.0 ? params.localStructure : params.skinStructure) : -1.0),
                             roundF16(params.autoMask > 0.0 ? params.localStructure : -1.0), 0.0);
}

#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// mode 0: 2x2 average pool (A = input at 2x size, C = output).
// mode 1: nearest 2x upsample of A plus R * S (per-channel scale), into C.
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer A { f16vec2 a[]; };
layout(std430, set = 0, binding = 2) writeonly buffer C { f16vec2 c[]; };
layout(std430, set = 0, binding = 3) readonly buffer R { f16vec2 r[]; };
layout(std430, set = 0, binding = 4) readonly buffer S { f16vec2 s[]; };
layout(push_constant) uniform P { uint mode, W, H, C; } p;   // W, H = output size
void main() {
  uint cp = p.C / 2, gid = gl_GlobalInvocationID.x;
  if (gid >= p.W * p.H * cp) return;
  uint ch = gid % cp, tok = gid / cp, x = tok % p.W, y = tok / p.W;
  if (p.mode == 0u) {
    uint iw = p.W * 2;
    uint i0 = ((2 * y) * iw + 2 * x) * cp + ch;
    f16vec2 v = (a[i0] + a[i0 + cp]) + (a[i0 + iw * cp] + a[i0 + iw * cp + cp]);
    c[gid] = v * float16_t(0.25);
  } else {
    uint lw = p.W / 2;
    f16vec2 low = a[((y / 2) * lw + (x / 2)) * cp + ch];
    c[gid] = fma(r[gid], s[ch], low);
  }
}

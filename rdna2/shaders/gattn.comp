#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
// ViT global attention over all coarsest-level tokens: one thread per (token, head), 32-channel heads, scaled cosine,
// packed f16. The exponential is the ViT variant of the network's bit trick (docs/network.md).
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer QKV { f16vec2 qkv[]; };    // [tokens][3C]
layout(std430, set = 0, binding = 2) writeonly buffer Out { f16vec2 outv[]; };  // [tokens][C]
layout(push_constant) uniform P { uint tokens, C, heads; float qscale; } p;
void main() {
  uint gid = gl_GlobalInvocationID.x;
  if (gid >= p.tokens * p.heads) return;
  uint h = gid % p.heads, tok = gid / p.heads;
  uint stride = 3 * p.C / 2, hc = p.C / 2;
  f16vec2 q[16];
  float qn = 0.0;
  for (uint d = 0; d < 16; d++) {
    q[d] = qkv[tok * stride + h * 16 + d];
    qn += dot(vec2(q[d]), vec2(q[d]));
  }
  float qi = p.qscale * inversesqrt(qn + 1e-6);
  for (uint d = 0; d < 16; d++) q[d] = f16vec2(vec2(q[d]) * qi);
  f16vec2 o[16];
  for (uint d = 0; d < 16; d++) o[d] = f16vec2(0.0hf);
  float sum = 0.0;
  for (uint j = 0; j < p.tokens; j++) {
    uint kb = j * stride + hc + h * 16;
    f16vec2 acc = f16vec2(0.0hf), kn = f16vec2(0.0hf);
    for (uint d = 0; d < 16; d++) {
      f16vec2 k = qkv[kb + d];
      acc = fma(q[d], k, acc);
      kn = fma(k, k, kn);
    }
    float s = float(acc.x + acc.y) * inversesqrt(float(kn.x + kn.y) + 1e-6);
    float16_t x = clamp(float16_t(0.08953947 * s + 1.70936143), float16_t(1.439453125), float16_t(1.9775390625));
    float16_t e = uint16BitsToFloat16(uint16_t(((uint(float16BitsToUint16(x)) << 4) + 0x4000u) & 0xffffu));
    sum += float(e);
    f16vec2 e2 = f16vec2(e, e);
    uint vb = kb + hc;
    for (uint d = 0; d < 16; d++) o[d] = fma(e2, qkv[vb + d], o[d]);
  }
  float inv = 1.0 / sum;
  for (uint d = 0; d < 16; d++) outv[tok * hc + h * 16 + d] = f16vec2(vec2(o[d]) * inv);
}
